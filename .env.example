# Gemini API configuration for BREAKGLASS
# Copy this file to .env and replace with your actual API key.
# Do NOT commit the .env file to Git!

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Required only when configuring TrueForge's genuine Daytona sandbox provider.
# Leave blank in version control; set the value only in your local .env.
DAYTONA_API_KEY=
